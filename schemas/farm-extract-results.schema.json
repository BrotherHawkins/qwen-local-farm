{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sift.local/schemas/farm-extract-results.schema.json",
  "title": "Sift Extract Run Results",
  "description": "Run-level extract aggregate artifact written as extract-results.json.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "preset",
    "status",
    "coverage",
    "counts",
    "items",
    "failures",
    "artifacts",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "mode": {
      "const": "extract"
    },
    "preset": {
      "type": "string",
      "enum": ["evidence", "entities", "work", "research"]
    },
    "focus": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": ["complete", "complete_with_warnings", "partial", "failed"]
    },
    "coverage": {
      "type": "object",
      "required": ["status", "total_jobs", "completed_jobs", "failed_jobs", "skipped_files"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["complete", "partial", "failed"]
        },
        "total_jobs": {"type": "integer"},
        "completed_jobs": {"type": "integer"},
        "failed_jobs": {"type": "integer"},
        "skipped_files": {"type": "integer"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["items", "by_type"],
      "properties": {
        "items": {"type": "integer"},
        "by_type": {
          "type": "object"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "text", "rank_score", "source_support", "sources"],
        "properties": {
          "id": {"type": "string"},
          "type": {
            "type": "string",
            "enum": [
              "claim",
              "fact",
              "example",
              "quote",
              "question",
              "tension",
              "entity",
              "link",
              "task",
              "decision",
              "risk",
              "requirement",
              "blocker",
              "follow_up"
            ]
          },
          "text": {"type": "string"},
          "entity_type": {"type": "string"},
          "url": {"type": "string"},
          "attributes": {"type": "object"},
          "rank_score": {"type": "number"},
          "source_support": {
            "type": "string",
            "enum": ["snippet_verified", "chunk_only"]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "source_support"],
              "properties": {
                "file": {"type": "string"},
                "chunk_id": {"type": ["string", "null"]},
                "snippet": {"type": ["string", "null"]},
                "source_support": {
                  "type": "string",
                  "enum": ["snippet_verified", "chunk_only"]
                },
                "char_start": {"type": ["integer", "null"]},
                "char_end": {"type": ["integer", "null"]}
              }
            }
          }
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["markdown", "json"],
      "properties": {
        "markdown": {"type": "string"},
        "json": {"type": "string"}
      }
    },
    "diagnostics": {
      "type": "object",
      "required": ["warnings", "dedupe"],
      "properties": {
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        },
        "dedupe": {
          "type": "object"
        }
      }
    }
  }
}
