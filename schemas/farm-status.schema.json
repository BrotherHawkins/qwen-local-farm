{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen-local-farm.local/schemas/farm-status.schema.json",
  "title": "Qwen Local Farm Persisted Run Status",
  "description": "Current persisted run status artifact written as farm-status.json.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "mode",
    "agent",
    "model",
    "runtime",
    "input",
    "output",
    "counts",
    "jobs",
    "skipped_files",
    "created_at",
    "updated_at",
    "timing"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["running", "complete", "complete_with_warnings", "partial", "failed"]
    },
    "mode": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "resource_mode": {
          "type": "object",
          "properties": {
            "requested": {
              "type": "string",
              "enum": ["auto", "gpu", "hybrid", "cpu"]
            },
            "effective": {
              "type": "string",
              "enum": ["gpu", "hybrid", "cpu"]
            },
            "source": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "agent_option_override": {
              "type": ["object", "null"]
            }
          }
        },
        "failure_policy": {
          "type": "object",
          "required": [
            "max_attempts",
            "per_file_timeout_seconds",
            "chunk_max_attempts",
            "reduce_max_attempts"
          ],
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1
            },
            "per_file_timeout_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "chunk_max_attempts": {
              "type": "integer",
              "minimum": 1
            },
            "reduce_max_attempts": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "request": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "instructions": {
          "type": ["string", "null"]
        },
        "agent": {
          "type": "string"
        }
      }
    },
    "retry": {
      "type": "object",
      "properties": {
        "source_run_id": {
          "type": "string"
        },
        "source_run_path": {
          "type": "string"
        },
        "selected_statuses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_failed_count": {
          "type": "integer"
        },
        "retried_count": {
          "type": "integer"
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_job_id": {
                "type": "string"
              },
              "retry_job_id": {
                "type": "string"
              },
              "input_path": {
                "type": "string"
              },
              "source_error": {
                "type": ["string", "null"]
              },
              "source_failure": {
                "type": ["object", "null"],
                "properties": {
                  "code": {"type": "string"},
                  "category": {"type": "string"},
                  "retryable": {"type": "boolean"},
                  "retry_after_fix": {"type": "boolean"},
                  "message": {"type": "string"},
                  "recommended_action": {"type": "string"}
                }
              }
            }
          }
        },
        "failure_counts": {
          "type": "object",
          "properties": {
            "retryable": {"type": "integer"},
            "non_retryable": {"type": "integer"},
            "unknown": {"type": "integer"}
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "input": {
      "type": "object",
      "required": ["path", "kind"],
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string"
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["queued", "running", "complete", "complete_with_warnings", "failed", "skipped", "total"],
      "properties": {
        "queued": {
          "type": "integer"
        },
        "running": {
          "type": "integer"
        },
        "complete": {
          "type": "integer"
        },
        "complete_with_warnings": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "skipped": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["job_id", "status", "input_path", "warnings", "chunking", "snippets", "timing"],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "running", "complete", "complete_with_warnings", "failed", "skipped"]
          },
          "input_path": {
            "type": "string"
          },
          "result_json": {
            "type": ["string", "null"]
          },
          "result_md": {
            "type": ["string", "null"]
          },
          "raw_response": {
            "type": ["string", "null"]
          },
          "error": {
            "type": ["string", "null"]
          },
          "failure": {
            "type": "object",
            "required": ["code", "category", "retryable", "retry_after_fix", "message", "recommended_action"],
            "properties": {
              "code": {"type": "string"},
              "category": {
                "type": "string",
                "enum": ["transient", "resource", "input", "configuration", "model_output", "internal"]
              },
              "retryable": {"type": "boolean"},
              "retry_after_fix": {"type": "boolean"},
              "message": {"type": "string"},
              "recommended_action": {"type": "string"}
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "chunking": {
            "type": "object"
          },
          "snippets": {
            "type": "object"
          },
          "timing": {
            "type": "object"
          },
          "progress": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string",
                "enum": ["queued", "starting", "single", "planning_chunks", "chunk_map", "reduce", "complete", "failed", "skipped"]
              },
              "message": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              },
              "chunks": {
                "type": "object",
                "properties": {
                  "total": {"type": "integer"},
                  "queued": {"type": "integer"},
                  "running": {"type": "integer"},
                  "complete": {"type": "integer"},
                  "failed": {"type": "integer"},
                  "current": {"type": ["string", "null"]}
                }
              },
              "reduce": {
                "type": "object",
                "properties": {
                  "generation": {"type": ["integer", "null"]},
                  "batch_index": {"type": ["integer", "null"]},
                  "batch_total": {"type": ["integer", "null"]},
                  "complete": {"type": "integer"}
                }
              },
              "current_call": {
                "type": ["object", "null"],
                "properties": {
                  "kind": {"type": "string"},
                  "file_path": {"type": "string"},
                  "chunk_id": {"type": "string"},
                  "attempt": {"type": "integer"},
                  "max_attempts": {"type": "integer"},
                  "started_at": {"type": "string"},
                  "completed_at": {"type": ["string", "null"]},
                  "duration_ms": {"type": ["integer", "null"]},
                  "status": {"type": "string"}
                }
              }
            }
          }
        }
      }
    },
    "skipped_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "timing": {
      "type": "object",
      "required": ["started_at", "completed_at", "duration_ms"],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "completed_at": {
          "type": ["string", "null"]
        },
        "duration_ms": {
          "type": ["integer", "null"]
        }
      }
    }
  }
}
