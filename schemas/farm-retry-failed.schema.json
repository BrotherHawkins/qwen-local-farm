{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sift.local/schemas/farm-retry-failed.schema.json",
  "title": "Sift Retry Failed JSON",
  "description": "CLI envelope printed by python sift.py farm retry-failed --json.",
  "type": "object",
  "required": ["schema_version", "status", "source_run", "retry_run", "failure_counts", "selected_jobs", "counts", "warnings", "errors"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": ["complete", "complete_with_warnings", "partial", "failed", "error"]
    },
    "source_run": {
      "type": "object",
      "properties": {
        "run_ref": {
          "type": "string"
        },
        "run_id": {
          "type": ["string", "null"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "failed_jobs": {
          "type": "integer"
        }
      }
    },
    "retry_run": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": ["string", "null"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "retried_jobs": {
          "type": "integer"
        }
      }
    },
    "failure_counts": {
      "type": "object",
      "required": ["retryable", "non_retryable", "unknown"],
      "properties": {
        "retryable": {
          "type": "integer"
        },
        "non_retryable": {
          "type": "integer"
        },
        "unknown": {
          "type": "integer"
        }
      }
    },
    "selected_jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_job_id": {
            "type": "string"
          },
          "retry_job_id": {
            "type": "string"
          },
          "input_path": {
            "type": "string"
          },
          "source_error": {
            "type": ["string", "null"]
          },
          "source_failure": {
            "type": ["object", "null"],
            "properties": {
              "code": {"type": "string"},
              "category": {"type": "string"},
              "retryable": {"type": "boolean"},
              "retry_after_fix": {"type": "boolean"},
              "message": {"type": "string"},
              "recommended_action": {"type": "string"}
            }
          }
        }
      }
    },
    "counts": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
